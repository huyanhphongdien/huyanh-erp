# =============================================================================
# Cân mủ lẻ (apps/retail-scale) — env theo NHÀ MÁY
# =============================================================================
# 1 codebase, deploy nhiều instance. Mỗi instance đặt 1 VITE_FACILITY_CODE riêng:
#
#   PD   → Phong Điền (HQ)        → canle.huyanhrubber.vn      (mặc định)
#   TL   → Nhà máy Quảng Trị      → canle-tl.huyanhrubber.vn
#   LAO  → Lào (Savannakhet)      → canle-lao.huyanhrubber.vn
#
# Code phải khớp cột `facilities.code` trong Supabase (hiện có: PD, TL, LAO).
# Để trống → fallback PD.
#
# CÁCH DÙNG: copy file này thành `.env` rồi điền anon key.
#   ⚠ KHÔNG commit file .env (đã thêm vào .gitignore).
# =============================================================================

VITE_FACILITY_CODE=PD

# Supabase — dùng chung 1 DB với ERP và app cân xe
VITE_SUPABASE_URL=https://dygveetaatqllhjusyzz.supabase.co
VITE_SUPABASE_ANON_KEY=
